{
  "name": "buyanov/noextlinks",
  "description": "This plugin hides external links",
  "license": "MIT",
  "require"    : {
    "php": ">=8.3",
    "ext-json": "*",
    "ext-zip": "*"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.10 || ^4.0",
    "phpunit/phpunit": "^10.5",
    "joomla/utilities": "^4.0",
    "joomla/uri": "^4.0",
    "joomla/registry": "^4.0",
    "joomla/input": "^4.0"
  },
  "config": {
    "bin-dir": "scripts",
    "cache-dir": ".composer-cache"
  },
  "scripts": {
    "test": "phpunit --testdox",
    "cs": "phpcs -n --standard=PSR2 --colors src",
    "build": "php tools/build.php build",
    "zip": "php tools/build.php zip"
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "Tests/",
      "Buyanov\\NoExtLinks\\": "src/"
    },
    "files": [
      "src/Support/helpers.php"
    ]
  }
}
